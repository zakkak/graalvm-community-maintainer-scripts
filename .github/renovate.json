{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["**/*.java"],
      "matchStrings": ["//DEPS\\s+(?<depName>[^:]+:[^:]+):(?<currentValue>[^\\s@]+)"],
      "datasourceTemplate": "maven"
    }
  ]
}
